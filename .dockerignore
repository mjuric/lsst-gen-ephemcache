# Keep the build context small and, more importantly, keep local install
# state out of the image.

# install.sh refuses to run if this exists ("cowardly refusing to proceed"),
# so a context copied from a machine where install.sh was run locally would
# break the build. It is generated inside the image anyway.
ephemcache.config

# Generated by install.sh inside the image. Locally these are ~780 MB and a
# full git checkout respectively.
sorcha_cache/
mpsky/

# outputs/ holds _workdir, which is ~41 GB mid-run on a real install. Never
# send it to the daemon.
outputs/

.git/
__pycache__/
*.pyc
build-manifest.*.txt
